APP_NAME="DSS Saham"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database configuration (pilih sqlite atau mysql)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dss_saham_db
# DB_USERNAME=root
# DB_PASSWORD=

# Laravel Sanctum token lifetime (dalam menit, 1440 = 24 jam)
SANCTUM_EXPIRATION=1440

# Initial Admin Seeder Credentials
ADMIN_INITIAL_EMAIL=admin@dssaham.com
ADMIN_INITIAL_PASSWORD=password123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"
